# AutoLens LK — Frontend Environment Configuration
# Copy this to .env for local development.

# API base path. Use /api/v1 locally (Vite proxies to the backend —
# the proxy target is configured in vite.config.ts).
VITE_API_URL=/api/v1

# Optional: public snapshot CDN base for dashboard/live stats when API is cold.
# VITE_SNAPSHOT_BASE_URL=https://<public-r2-domain>/latest

# Optional: frontend error tracking. Loaded dynamically only when set.
# VITE_SENTRY_DSN=

# Optional auth — production must use backend auth; never ship demo users to production.
# VITE_ENABLE_BACKEND_AUTH=true
# VITE_ENABLE_DEMO_AUTH=true
# VITE_DEMO_USERS=[{"email":"demo@example.com","password":"demo","name":"Demo User","plan":"pro"}]

# Pro access enforcement — mirrors the backend PRO_ACCESS_ENFORCED flag.
# The backend now enforces the Pro gate BY DEFAULT; production builds of the
# frontend also gate exports by default. Set false only for local development.
# VITE_PRO_ACCESS_ENFORCED=true

# Production checklist (Vercel + HF + GitHub):
# 1. Backend Pro gate is enforced by default — ensure AUTH_TOKEN_SECRET and
#    AUTH_USERS (bcrypt password_hash entries) are set on HF, or Pro pages 401.
# 2. Set VITE_ENABLE_BACKEND_AUTH=true + VITE_PRO_ACCESS_ENFORCED=true on Vercel.
# 3. Set VITE_SENTRY_DSN (Vercel) and SENTRY_DSN (HF) for error tracking.
# 4. Add GitHub secret SLACK_WEBHOOK_URL for scrape-failure alerts
#    (daily-scrape.yml / midday-top-sources-scrape.yml).
# 5. Add GitHub secrets SENDGRID_API_KEY + DIGEST_RECIPIENTS for live weekly digests
#    (workflow: .github/workflows/weekly-digest.yml — scheduled runs stay dry-run until secrets are set).
# 6. Optional WhatsApp alerts: set TWILIO_* secrets on HF (see backend/.env.example).
# 7. Confirm listings work after backend deploys (schema patches auto-add
#    thumbnail_url_cached, is_active, content_updated_at, notify_phone).
# 8. keep-hf-awake.yml pings /health every 10 minutes to reduce Spaces sleep.