# AutoLens LK — Frontend Environment Configuration
# Copy this to .env for local development.

# API base path. Use /api/v1 locally (Vite proxies to the backend).
VITE_API_URL=/api/v1

# Backend origin used by the Vite dev proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: public snapshot CDN base for dashboard/live stats when API is cold.
# VITE_SNAPSHOT_BASE_URL=https://<public-r2-domain>/latest

# Optional auth (production builds)
# VITE_ENABLE_BACKEND_AUTH=true
# VITE_ENABLE_DEMO_AUTH=true
# VITE_DEMO_USERS=[{"email":"demo@example.com","password":"demo","name":"Demo User","role":"user"}]

# Pro access enforcement — mirrors the backend PRO_ACCESS_ENFORCED flag.
# When true (or when the app is running as a production build), export actions
# in the Pro dashboard are gated behind a valid Pro session.  Defaults to false
# so local / preview deployments keep working without auth configuration.
# VITE_PRO_ACCESS_ENFORCED=true

# Production checklist (Vercel + HF):
# 1. Set VITE_PRO_ACCESS_ENFORCED=true on Vercel and PRO_ACCESS_ENFORCED=true on HF.
# 2. Add GitHub secrets SENDGRID_API_KEY + DIGEST_RECIPIENTS for live weekly digests
#    (workflow: .github/workflows/weekly-digest.yml — scheduled runs stay dry-run until secrets are set).
# 3. Confirm listings work after backend deploys (schema patches auto-add thumbnail_url_cached).
