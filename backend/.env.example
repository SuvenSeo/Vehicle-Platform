# AutoLens LK — Backend Environment Configuration
# Copy this to .env and fill in your values

# PostgreSQL connection (Supabase Transaction Pooler URL recommended)
# Example format:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Hugging Face Spaces: set these as Space secrets (Settings → Variables and secrets)
# HOT_DATABASE_URL=postgresql://...   (Supabase — API reads)
# COLD_DATABASE_URL=postgresql://...  (Neon — scraper writes; optional if single DB)
# ALLOW_SQLITE_FALLBACK=false
# CORS_ORIGINS=https://vehicle-platform-one.vercel.app,http://localhost:5173
# DAILY_SYNC_RUN_ON_STARTUP=false   (recommended — sync on startup can delay API for ~90 min)
# DAILY_SYNC_ENABLED=true

# Set to false in production to fail fast when DATABASE_URL is missing.
ALLOW_SQLITE_FALLBACK=true

# Admin API key (keep secret — used to trigger scrapers)
ADMIN_API_KEY=your-secret-admin-key-here

# Comma-separated frontend origins for CORS (include your Vercel production URL)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,https://vehicle-platform-one.vercel.app

# --- Pro gate (HF Space secret) ---
# When true, every /api/v1/pro/* route requires a valid pro/enterprise token.
# Pair with VITE_PRO_ACCESS_ENFORCED=true on Vercel so export UI matches the API.
# PRO_ACCESS_ENFORCED=true

# --- Weekly Pro digest (GitHub Actions secrets / HF optional) ---
# SENDGRID_API_KEY=SG.xxx
# DIGEST_RECIPIENTS=dealer@example.com,ops@example.com
# DIGEST_FROM_EMAIL=noreply@autolens.lk
# DIGEST_SUBJECT=AutoLens Pro — Weekly Market Digest

# --- Optional runtime caps ---
# SSE_MAX_CONNECTIONS=50
# RUN_THUMBNAIL_CACHE=false
# THUMBNAIL_BATCH_LIMIT=100
# CDN_BASE_URL=

# --- Real Pro authentication (optional) ---
# AUTH_TOKEN_SECRET=<long-random-string>
# AUTH_TOKEN_TTL_SECONDS=86400
# AUTH_USERS currently stores unsalted SHA-256 password hashes (see auth.py).
# Treat this as a stopgap, not production-grade credential storage —
# do not reuse these passwords elsewhere.
# AUTH_USERS=[{"email":"owner@example.com","password_sha256":"<hex>","name":"Owner","plan":"enterprise","subscription_status":"active"}]

# --- AI chat assistant (optional, Groq) ---
# GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=llama-3.1-8b-instant

# --- In-Space scheduler (optional, off by default — see README §8) ---
# DAILY_SYNC_ENABLED=false
# DAILY_SYNC_RUN_ON_STARTUP=false
# DAILY_SYNC_HOURS=6,18   (comma-separated 0-23; default [6, 18] if unset)
# DAILY_SYNC_TIMEZONE=Asia/Colombo
# DAILY_SYNC_PROFILE=daily
# DAILY_SYNC_TIMEOUT_SECONDS=5400
