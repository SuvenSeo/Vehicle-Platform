<?xml version="1.0" encoding="utf-8"?>
<!--
  App shortcuts. Manifest owner references this file:
  <meta-data android:name="android.app.shortcuts"
      android:resource="@xml/shortcuts" />
  inside MainActivity. Labels use strings.xml names (not the legacy
  shortcut_scan / shortcut_voice / shortcut_deal ids). Deep links are handled
  end-to-end: MainActivity ACTION_VIEW → splash → type-safe destination, plus
  NavHost deepLinks on the matching composable.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
      android:shortcutId="scan_plate"
      android:enabled="true"
      android:icon="@android:drawable/ic_menu_camera"
      android:shortcutShortLabel="@string/shortcut_scan_plate_short"
      android:shortcutLongLabel="@string/shortcut_scan_plate_long">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="lk.motormila.app"
        android:targetClass="lk.motormila.app.MainActivity"
        android:data="motormila://scan" />
    <categories android:name="android.shortcut.conversation" />
  </shortcut>

  <shortcut
      android:shortcutId="voice_search"
      android:enabled="true"
      android:icon="@android:drawable/ic_btn_speak_now"
      android:shortcutShortLabel="@string/shortcut_voice_search_short"
      android:shortcutLongLabel="@string/shortcut_voice_search_long">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="lk.motormila.app"
        android:targetClass="lk.motormila.app.MainActivity"
        android:data="motormila://search?voice=true" />
  </shortcut>

  <shortcut
      android:shortcutId="deal_of_day"
      android:enabled="true"
      android:icon="@android:drawable/ic_menu_info_details"
      android:shortcutShortLabel="@string/shortcut_deal_of_day_short"
      android:shortcutLongLabel="@string/shortcut_deal_of_day_long">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="lk.motormila.app"
        android:targetClass="lk.motormila.app.MainActivity"
        android:data="motormila://home?dealOfDay=true" />
  </shortcut>

  <shortcut
      android:shortcutId="watchlist"
      android:enabled="true"
      android:icon="@android:drawable/ic_menu_save"
      android:shortcutShortLabel="@string/shortcut_watchlist_short"
      android:shortcutLongLabel="@string/shortcut_watchlist_long">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="lk.motormila.app"
        android:targetClass="lk.motormila.app.MainActivity"
        android:data="motormila://watchlist" />
  </shortcut>
</shortcuts>
